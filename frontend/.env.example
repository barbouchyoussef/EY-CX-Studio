# Frontend environment template. Copy to `.env` (or `.env.local`) and adjust.
# Base URL of the backend API. Defaults to the local dev server if unset.
#
# IMPORTANT (auth cookies): the refresh token is a SameSite cookie, so the SPA and the API
# must be on the SAME host. The Vite dev server serves the app on localhost, so use localhost
# here too (NOT 127.0.0.1) -- localhost and 127.0.0.1 count as different sites and the cookie
# would be dropped. Open the app at http://localhost:5173.
VITE_API_BASE_URL=http://localhost:8000/api/v1

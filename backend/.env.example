# ─────────────────────────────────────────────────────────────────────────────
# EY CX Assessment Hub — backend environment template
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (required) ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/cx_assessment
APP_NAME=CX Assessment API
APP_ENV=development

# ── Auth / identity ──────────────────────────────────────────────────────────
# Signing key for JWT access tokens. REQUIRED when APP_ENV != development.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=45        # short-lived; the SPA keeps this in memory only
REFRESH_TOKEN_DAYS=14          # rotating refresh token, stored in an HttpOnly cookie
INVITE_EXPIRE_HOURS=168        # invitation validity (default 7 days)
# Refresh-cookie flags. In production keep COOKIE_SECURE=true (HTTPS) and SAMESITE=strict.
# Dev note: serve the SPA and API on the SAME host (both localhost, or both 127.0.0.1) or
# SameSite will drop the cookie. With the SPA on localhost:5173, use localhost for the API.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
COOKIE_DOMAIN=

PASSWORD_RESET_EXPIRE_HOURS=2   # password-reset link validity (short on purpose)

# Bootstrap admin (used by: python -m app.scripts.create_admin). Not read at runtime.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Email (transactional: invites + password reset) ──────────────────────────
# Public base URL of the SPA -- reset/invite links are built as APP_BASE_URL/accept-invite?...
APP_BASE_URL=http://localhost:5173
# SMTP for the dedicated sending mailbox. Leave SMTP_HOST blank to disable sending
# (invite tokens are then returned in the API response for manual sharing).
# Gmail example: host=smtp.gmail.com port=587 TLS=true, username=the mailbox, password=an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=EY CX Studio

# ── LLM providers ────────────────────────────────────────────────────────────
# The assessment/report/chat features need at least one working chat provider.
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Optional chat provider (Kimi / Moonshot), used first for chat when set.
MOONSHOT_API_KEY=
MOONSHOT_MODEL=moonshot-v1-8k
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Gemini failover for report synthesis + image captioning (comma-separated keys allowed).
GEMINI_API_KEYS=
GEMINI_TEXT_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash,gemini-flash-latest
GEMINI_VLM_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-flash-lite-latest

# OpenRouter VLM failover (desk-research image captioning).
OPENROUTER_API_KEY=
OPENROUTER_VLM_MODEL=

# ── Web search + scraping ────────────────────────────────────────────────────
LANGSEARCH_API_KEY=
LANGSEARCH_BASE_URL=https://api.langsearch.com/v1
# Apify token for the social-listening scrapers (reviews, Facebook, etc.).
APIFY_API_TOKEN=
# Bright Data token for Facebook page/comment scraping (page scraping is skipped when unset).
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_FB_POSTS_DATASET_ID=gd_lkaxegm826bjpoo9m5
BRIGHTDATA_FB_COMMENTS_DATASET_ID=gd_lkay758p1eanlolqw8

# ── Desk Research & RAG ──────────────────────────────────────────────────────
# EasyOCR languages for scanned PDFs. Arabic-family only combines with English.
DESK_OCR_LANGS=ar,en
# Embeddings backend for the chatbots: "local" (multilingual-e5-small) or "none" (lexical).
RAG_EMBED_BACKEND=local
RAG_EMBED_MODEL=intfloat/multilingual-e5-small
# Minimum cosine similarity to keep a semantic hit (0 = keep top-k regardless).
RAG_MIN_SCORE=0.0

# ── Metabase dashboards (optional) ───────────────────────────────────────────
METABASE_SITE_URL=
METABASE_EMBED_SECRET=
METABASE_DASHBOARD_ID=

# ── Misc ─────────────────────────────────────────────────────────────────────
# Where the "book a consultation" form sends notifications (optional).
CONSULTATION_RECEIVER_EMAIL=

# --- Langfuse (LLM tracing + evaluation; optional, disabled if unset) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
